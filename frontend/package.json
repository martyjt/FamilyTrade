    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "globals": "16.5.0",
    "jsdom": "29.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
